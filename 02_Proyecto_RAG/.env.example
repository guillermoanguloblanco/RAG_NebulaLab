# Copiar a .env y rellenar la clave (no subir .env al repositorio)
GEMINI_API_KEY=
# Varios modelos separados por comas: si el primero no está disponible se usa el siguiente
GEMINI_MODEL=gemini-3.5-flash,gemini-3.1-flash-lite
# gemini (búsqueda semántica, configuración final) o tfidf (local, sin API)
EMBEDDING_BACKEND=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Opcionales: umbral de rechazo y margen de recorte del contexto (distancia coseno)
UMBRAL_RECHAZO=
MARGEN_CONTEXTO=
